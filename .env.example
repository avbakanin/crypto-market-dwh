# Snowflake connections of the loader and of dbt (service users, key-pair auth).
# Copy to .env and fill in. Never commit .env or the private key.
# The private key lives outside the repo; the passphrase is needed only for an encrypted key.
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=CRYPTO_LOADER
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/keys/crypto_loader_rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=CRYPTO_DWH_ROLE
SNOWFLAKE_WAREHOUSE=CRYPTO_WH
SNOWFLAKE_DATABASE=CRYPTO_DWH
SNOWFLAKE_SCHEMA=RAW

# dbt (service user CRYPTO_DBT; user and role are in dbt/profiles.yml). dbt 1.12 loads
# this file itself; run dbt from the repo root.
DBT_PROJECT_DIR=dbt
DBT_PROFILES_DIR=dbt
# Absolute path: dbt does not expand ~ (the loader does).
SNOWFLAKE_DBT_PRIVATE_KEY_PATH=C:/Users/<you>/.snowflake/keys/crypto_dbt_rsa_key.p8
DBT_ENV_SECRET_SNOWFLAKE_DBT_KEY_PASSPHRASE=

# Export of the marts for the dashboard (ingestion/export_marts.py): read-only service user
# CRYPTO_REPORTER; user, role and namespace are fixed in ingestion/clients/snowflake_conn.py.
SNOWFLAKE_REPORTER_PRIVATE_KEY_PATH=~/.snowflake/keys/crypto_reporter_rsa_key.p8
SNOWFLAKE_REPORTER_PRIVATE_KEY_PASSPHRASE=

# Docker (docker-compose.yaml). Compose reads this file only to fill in ${...};
# containers get container paths instead of the host paths above, and the key
# files below arrive as read-only secrets. Host directory with the three keys:
SNOWFLAKE_KEYS_DIR=C:/Users/<you>/.snowflake/keys

# Airflow (docker-compose.yaml): random values, generated once and never printed.
# Do not change AIRFLOW_POSTGRES_PASSWORD or AIRFLOW_FERNET_KEY once the stack has run:
# postgres keeps the first password, and stored connections are encrypted with the key.
# Fernet key: cryptography.fernet.Fernet.generate_key(); the rest: secrets.token_urlsafe(32).
AIRFLOW_POSTGRES_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=
# Airflow UI login (user created by airflow-init; the password is applied only on creation).
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=

# Alerts (dags/alerting). Telegram bot from @BotFather; the chat id of the chat that gets
# the messages. The bot token is a password: never paste it into a chat or a screenshot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Outside watchdog (healthchecks.io): the ping URL of the check; alerts when pings stop.
PIPELINE_HEARTBEAT_URL=
