# Snowflake connection for the loader (service user, key-pair auth).
# Copy to .env and fill in. Never commit .env or the private key.
# The private key lives outside the repo; the passphrase is needed only for an encrypted key.
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=CRYPTO_LOADER
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/keys/crypto_loader_rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=CRYPTO_DWH_ROLE
SNOWFLAKE_WAREHOUSE=CRYPTO_WH
SNOWFLAKE_DATABASE=CRYPTO_DWH
SNOWFLAKE_SCHEMA=RAW
